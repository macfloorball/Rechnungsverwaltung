#!/usr/bin/env bash
set -euo pipefail
# Preserve Chromium sandboxing. If the host disallows it, startup must fail
# instead of silently weakening the application's security configuration.
app_dir="${APPDIR:-$(cd -- "$(dirname -- "$0")" && pwd)}"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$app_dir/ttc-rechnungsverwaltung" "$@"
